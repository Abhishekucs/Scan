# App (set to your production URL on Vercel, e.g. https://your-app.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Durable storage — Upstash Redis via Vercel Marketplace
# Prefer the KV_* vars from the Vercel KV / Upstash Marketplace integration.
# Either pair works; if unset, scans fall back to local .data/scans JSON files.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional scan retention in Redis (seconds). Default: 2592000 (30 days)
# SCAN_TTL_SECONDS=2592000

# Optional: Google PageSpeed Insights API key
# https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# Stripe (optional — checkout unlocks locally for demos when unset)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ONE_OFF=
STRIPE_PRICE_MONITORING=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional unlock bypass for demos (comma-separated scan IDs)
# DEMO_UNLOCKED_SCANS=
